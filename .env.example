# GEMINI_API_KEY: Required for server-side Gemini AI highlight detection & metadata generation (Phase 3+).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloud SQL (PostgreSQL) runtime variables (injected automatically in AI Studio)
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""

# Optional external object storage & Redis queue for multi-node deployments
REDIS_URL=""
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
MEDIA_SIGNING_SECRET=""
